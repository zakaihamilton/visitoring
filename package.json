{
  "name": "visitoring",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "workspaces:provision": "tsx scripts/provision-workspace.ts",
    "sites:provision": "tsx scripts/provision-site.ts",
    "import:sentry8": "tsx scripts/import-sentry8.ts",
    "retention:prune": "tsx scripts/prune-events.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format:check": "biome format .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dead-code": "knip",
    "duplication": "jscpd src scripts tests --threshold 5",
    "health": "repnix check"
  },
  "dependencies": {
    "@neon/config": "^1.8.3",
    "bowser": "^2.11.0",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.1",
    "maxmind": "^4.3.24",
    "next": "^16.3.4",
    "pg": "^8.16.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "server-only": "^0.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.7",
    "jscpd": "^4.0.5",
    "knip": "^5.70.0",
    "repnix": "^1.0.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
