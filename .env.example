# Optional local-only PostgreSQL for isolated development. Uncomment to bypass Nanogres locally.
# LOCAL_DATABASE_URL=postgres://visitoring:visitoring@localhost:5433/visitoring

# Nanogres workload identity: deployed connections use no database password.
NANOGRES_ORGANIZATION_ID=
NANOGRES_DATABASE=visitoring
NANOGRES_RUNTIME_ROLE=
NANOGRES_MIGRATION_ROLE=
# Optional owner role assumed by the migration runner after certificate login.
NANOGRES_MIGRATION_OWNER_ROLE=
NANOGRES_IDENTITY_URL=https://nanogres.vercel.app/api/workload-identity
# Local Nanogres use needs a short-lived Vercel OIDC token, provided by `vercel env pull`.

# Use a random value of at least 32 UTF-8 bytes in production.
RATE_LIMIT_SECRET=replace-with-at-least-32-random-bytes

# Per-site/IP collection cap for each 15-minute window. Defaults to 120.
# COLLECTOR_RATE_LIMIT_MAX_EVENTS=120

# Visitoring uses Perminister for all sign-ins and member management.
PERMINISTER_BASE_URL=https://www.perminister.com
PERMINISTER_APP_CLIENT_ID=
PERMINISTER_APP_CLIENT_SECRET=
PERMINISTER_PRODUCT_ID=visitoring

# Set true only when a trusted reverse proxy overwrites one of these with one client IP.
TRUST_PROXY_HEADERS=false

# Optional DB-IP City Lite MMDB. Keep the downloaded file outside the repository.
GEOIP_DB_PATH=/absolute/path/to/dbip-city-lite.mmdb
