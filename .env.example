# Local PostgreSQL; `docker compose up -d db` starts this service.
DATABASE_URL=postgres://visitoring:visitoring@localhost:5433/visitoring

# Use long random values in production. RATE_LIMIT_SECRET may reuse AUTH_SECRET.
AUTH_SECRET=replace-with-at-least-32-random-bytes
RATE_LIMIT_SECRET=replace-with-a-different-random-secret

# Set true only when a trusted reverse proxy overwrites one of these with one client IP.
TRUST_PROXY_HEADERS=false

# Optional DB-IP City Lite MMDB. Keep the downloaded file outside the repository.
GEOIP_DB_PATH=/absolute/path/to/dbip-city-lite.mmdb

# Sentry8 read-only PostgreSQL connection string, set only for history import.
SENTRY8_DATABASE_URL=
