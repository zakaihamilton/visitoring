{
  "name": "visitoring",
  "version": "0.1.0",
  "description": "React integration for Visitoring website analytics",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zakaihamilton/visitoring.git",
    "directory": "packages/react"
  },
  "homepage": "https://visitoring.vercel.app/developers",
  "bugs": {
    "url": "https://github.com/zakaihamilton/visitoring/issues"
  },
  "keywords": [
    "analytics",
    "visitoring",
    "react",
    "web-analytics",
    "typescript"
  ],
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint src && eslint src",
    "format:check": "biome format .",
    "test": "pnpm --dir ../.. run test -- tests/react-sdk.test.tsx tests/react-sdk-ssr.test.tsx",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0 <20"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
